imports Input from "./contracts.eff"
imports Transform from "./contracts.eff"
imports Output from "./contracts.eff"
import { Int, Item, InputFailure, TransformFailure, OutputFailure } from "./contracts.eff"

const convert = (item: Item) =>
  try { { id: item.id, value: Transform.apply(item), recovered: false } } catch {
    TransformFailure(error) =>
      if (error.kind === "Recoverable") { { id: item.id, value: item.value, recovered: true } }
      else { fail(error) }
  }

const process = (input: Int, output: Int) => {
  const incoming = bufferStream(unfold(0, index => Input.next(input, index)), { capacity: 2 })
  const converted = mapEffect(incoming, item => convert(item), { concurrency: 2 })
  const batches = transduceStream(converted, takeSink(2))
  runStream(batches, sinkForEach(batch =>
    if (len(batch) > 0) { Output.write(output, batch) } else {}))
}

const withOutput = (input: Int) =>
  using (consumer = {
      const output = Output.open()
      {
        run: () => process(input, output),
        close: () => Output.close(output)
      }
    }) {
      consumer.run()
    } finally {
      consumer.close()
    }

export const runProcessor = (): void =>
  using (source = {
      const input = Input.open()
      {
        run: () => withOutput(input),
        close: () => Input.close(input)
      }
    }) {
      source.run()
    } finally {
      source.close()
    }
