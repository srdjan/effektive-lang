export type Int = int
type Cents = int
type Text = string
type Nil = null
type Item = { r: Int }
type Circle = { radius: Int }
type Square = { side: Int }
type Shape = Circle | Square
export type MaybeInt = Int | null
type MaybeCents = Cents | null
type MaybeItem = Item | null
type MaybeShape = Shape | null
type MaybeBool = boolean | null
type M2 = "a" | "b"
type MaybeM2 = M2 | null
type IntOrNil = Int | Nil
type M2OrNil = M2 | Nil

export const next = (x: MaybeInt): Int =>
  match x {
    null => 0,
    n => n + 1
  }

export const price = (c: MaybeCents): Cents =>
  match c {
    null => 0,
    n => n
  }

export const orNil = (x: IntOrNil): Int =>
  match x {
    null => 0,
    n => n
  }

const nothing: MaybeItem = null

export const fromConstant = (): Int =>
  match nothing {
    null => 0,
    n => n.r
  }

export const fromBlock = (): Int => {
  const s: MaybeItem = null
  match s {
    null => 0,
    n => n.r
  }
}

const measure = (s: Shape): Int =>
  match s {
    Circle(c) => c.radius,
    Square(q) => q.side
  }

export const shaped = (s: MaybeShape): Int =>
  match s {
    null => 0,
    n => measure(n)
  }

export const shapedNested = (s: MaybeShape): Int =>
  match s {
    null => 0,
    n =>
      match n {
        Circle(c) => c.radius,
        Square(q) => q.side
      }
  }

export const wild = (x: MaybeInt): Int =>
  match x {
    null => 0,
    _ => 1
  }

export const flag = (b: MaybeBool): Int =>
  match b {
    null => 0,
    true => 1,
    false => 2
  }

export const mode = (m: MaybeM2): Int =>
  match m {
    null => 0,
    "a" => 1,
    "b" => 2
  }

export const modeNil = (m: M2OrNil): Int =>
  match m {
    null => 0,
    "a" => 1,
    "b" => 2
  }

type MaybeAnItemWithAVeryLongNameThatPushesTheSelectorAnnotationPastTheLimit =
  Item | null

export const longName = (
  x: MaybeAnItemWithAVeryLongNameThatPushesTheSelectorAnnotationPastTheLimit,
): Int =>
  match x {
    null => 0,
    n => n.r
  }
