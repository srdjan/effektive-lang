type Flag = boolean
type Tag = "a" | "b"
type Int = int

export const numbers = (): Flag => 1 === 2
export const negated = (): Flag => !true
export const texts = (): Flag => "x" === "y"
export const differ = (): Flag => 1 !== 2
export const flagIsOff = (): Flag => {
  const on: Flag = true
  on === false
}
export const flagIsNot = (): Flag => {
  const on: Flag = true
  !on
}
export const tagIsB = (): Flag => {
  const t: Tag = "a"
  t === "b"
}
export const flagsEqual = (): Flag => {
  const on: Flag = true
  const off: Flag = false
  on === off
}
export const below = (): Flag => 1 < 2
export const leftLiteral = (n: Int): Flag => 1 === n
export const intIsFour = (): Flag => {
  const n: Int = 3
  n === 4
}
