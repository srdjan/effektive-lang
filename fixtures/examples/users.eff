imports Users from "./users-service.eff"
import {
  Name,
  StoreUnavailable,
  User,
  UserId,
  UserMissing
} from "./users-service.eff"

export const getUser = (id: UserId): User =>
  match Users.find(id) {
    Some(user) => user,
    None => fail(UserMissing({ id }))
  }

export const rename = (id: UserId, name: Name): User => {
  const user = getUser(id)
  const renamed = { ...user, name }
  Users.save(renamed)
  renamed
}

export const displayName = (id: UserId): Name =>
  try {
    getUser(id).name
  } catch {
    UserMissing(error) => "Guest"
  }

export const activeNames = (): Name[] =>
  Users.all()
    |> filter(user => user.active)
    |> map(user => user.name)

