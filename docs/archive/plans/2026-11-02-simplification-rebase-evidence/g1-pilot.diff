-      node,
-      table.map(inferred.key, inferred.value),
-      inferred.info,
-    );
-  }
-  const info = c.argInfo(arg);
-  const pair = pairParts(c, info.type);
-  if (pair === undefined) {
-    if (!c.isError(info.type)) {
-      c.report(
-        "type-mismatch/003",
-        `the mapOf entries has type ${
-          showType(c.table, info.type)
